[{"category":"array","description":"Given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target. You may assume that each input would have exactly one solution, and you may not use the same element twice.","difficulty":"Easy","examples":[{"input":"[2,7,11,15]\n9\n[0,1]","output":"[0,1]","raw":"nums=[2,7,11,15] target=9 => [0,1]"},{"input":"[3,2,4]\n6","output":"[1,2]","raw":"nums=[3,2,4] target=6 => [1,2]"}],"leetcode_slug":"two-sum","slug":"two-sum","source":"leetcode","test_cases":[{"expect":"[0,1]","input":"{\"nums\":[2,7,11,15],\"target\":9}","raw":"nums=[2,7,11,15] target=9 => [0,1]"},{"expect":"[1,2]","input":"{\"nums\":[3,2,4],\"target\":6}","raw":"nums=[3,2,4] target=6 => [1,2]"},{"expect":"[0,1]","input":"{\"nums\":[3,3],\"target\":6}","raw":"nums=[3,3] target=6 => [0,1]"},{"expect":"[2,4]","input":"{\"nums\":[-1,-2,-3,-4,-5],\"target\":-8}","raw":"nums=[-1,-2,-3,-4,-5] target=-8 => [2,4] (edge negative)"},{"expect":"[0,3]","input":"{\"nums\":[0,4,3,0],\"target\":0}","raw":"nums=[0,4,3,0] target=0 => [0,3] (edge zero)"},{"expect":"[0,1]","input":"{\"nums\":[1000000,2,3,999999],\"target\":1000002}","raw":"large nums => [0,1] (edge large)"}],"title":"Two Sum"},{"category":"stack","description":"Given a string s containing just the characters '(', ')', '{', '}', '[' and ']', determine if the input string is valid.","difficulty":"Easy","examples":[{"input":"\"()\"","output":"true"},{"input":"\"()[]{}\"","output":"true"}],"leetcode_slug":"valid-parentheses","slug":"valid-parentheses","source":"leetcode","test_cases":[{"expect":"true","input":"{\"s\":\"()\"}","raw":"s=\"()\" => true"},{"expect":"true","input":"{\"s\":\"()[]{}\"}","raw":"s=\"()[]{}\" => true"},{"expect":"false","input":"{\"s\":\"(]\"}","raw":"s=\"(]\" => false"},{"expect":"true","input":"{\"s\":\"\"}","raw":"s=\"\" => true (empty valid) edge"},{"expect":"false","input":"{\"s\":\"(((((((\"}","raw":"s=\"((((((( \" => false edge"},{"expect":"false","input":"{\"s\":\"{{{}}}\"}","raw":"s=\"{{{}}}\" => false (mismatch) edge"}],"title":"Valid Parentheses"},{"category":"linked-list","description":"You are given the heads of two sorted linked lists list1 and list2. Merge the two lists into one sorted list.","difficulty":"Easy","examples":[{"input":"l1=[1,2,4] l2=[1,3,4]","output":"[1,1,2,3,4,4]"}],"leetcode_slug":"merge-two-sorted-lists","slug":"merge-two-sorted-lists","source":"leetcode","test_cases":[{"expect":"[1,1,2,3,4,4]","input":"{\"l1\":[1,2,4],\"l2\":[1,3,4]}","raw":"l1=[1,2,4] l2=[1,3,4] => [1,1,2,3,4,4]"},{"expect":"[]","input":"{\"l1\":[],\"l2\":[]}","raw":"both empty => []"},{"expect":"[1]","input":"{\"l1\":[1],\"l2\":[]}","raw":"l1=[1] l2=[] => [1] edge"},{"expect":"[1,2,3,5]","input":"{\"l1\":[5],\"l2\":[1,2,3]}","raw":"l1=[5] l2=[1,2,3] => [1,2,3,5] edge"}],"title":"Merge Two Sorted Lists"},{"category":"design","description":"Design a data structure that follows the constraints of a Least Recently Used (LRU) cache.","difficulty":"Medium","examples":[{"input":"capacity=2 ops...","output":"[null,null,1,null,-1,3]"}],"leetcode_slug":"lru-cache","slug":"lru-cache","source":"leetcode","test_cases":[{"expect":"[null,null,null,1,null,-1,null,-1,3,4]","input":"{\"operations\":[\"LRUCache\",\"put\",\"put\",\"get\",\"put\",\"get\",\"put\",\"get\",\"get\",\"get\"],\"capacity\":2,\"data\":[[2],[1,1],[2,2],[1],[3,3],[2],[4,4],[1],[3],[4]]}","raw":"official LRUCache seq capacity 2"},{"expect":"[null,null,1]","input":"{\"operations\":[\"LRUCache\",\"put\",\"get\"],\"capacity\":1,\"data\":[[1],[1,1],[1]]}","raw":"LRU 1 ops put-get edge"}],"title":"LRU Cache"},{"category":"system-design","description":"Design a simplified version of Twitter where users can post tweets, follow/unfollow, and see news feed. System design discussion: API, storage, fan-out, timeline. For code runner, simulate via simplified feed array operations.","difficulty":"Medium","examples":[{"input":"tweet feed","output":"feed returns recent 10"}],"leetcode_slug":"design-twitter","slug":"design-twitter","source":"leetcode","test_cases":[{"expect":"\"feed returns recent 10\"","input":"{\"scenario\":\"post tweet + fan-out read\"}","raw":"tweet feed scenario"},{"expect":"\"feed empty after unfollow\"","input":"{\"scenario\":\"follow then unfollow edge\"}","raw":"follow-unfollow edge"}],"title":"Design Twitter — System Design variant"}]