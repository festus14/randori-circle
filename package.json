{
  "dependencies": {
    "@libsql/client": "^0.12.0",
    "@sentry/node": "^10.75.0",
    "@vercel/functions": "^3.10.1",
    "@vercel/sandbox": "^3.8.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "resend": "^4.0.0",
    "yjs": "13.6.27"
  },
  "name": "randori-circle",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "dev": "node --env-file-if-exists=.env.local scripts/local-server.mjs",
    "dev:reset": "node --env-file-if-exists=.env.local scripts/local-reset.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:turso": "node scripts/turso-production-migrate.mjs",
    "db:plan": "node scripts/db-inspect.mjs plan",
    "db:rehearse-restore": "node scripts/turso-backup-restore-rehearsal.mjs",
    "db:monitor-backup": "node scripts/turso-backup-restore-monitor.mjs",
    "db:watch-backup": "node scripts/github-backup-restore-watchdog.mjs",
    "keys:control": "node scripts/credential-key-control.mjs",
    "chat:retention": "node scripts/chat-retention.mjs",
    "db:status": "node scripts/db-inspect.mjs status",
    "check:deployability": "node scripts/check-deployability.mjs",
    "check:backup-controls": "node scripts/check-backup-controls.mjs",
    "check:runtime-ddl": "node scripts/check-runtime-ddl.mjs",
    "check:syntax": "node tests/static/check-syntax.mjs",
    "check:turso-sql": "node scripts/check-turso-remote-sql.mjs",
    "check:crdt": "node scripts/check-crdt-bundle.mjs",
    "build:crdt": "esbuild assets/crdt-editor-source.js --bundle --format=iife --platform=browser --target=es2020 --alias:monaco-editor/esm/vs/editor/editor.api.js=./assets/monaco-api-shim.js --outfile=assets/crdt-editor.js",
    "smoke:execution": "node --env-file-if-exists=.env.local scripts/execution-smoke.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "catalog:takedown": "node scripts/catalog-provenance.mjs takedown",
    "test:unit": "node --experimental-test-module-mocks --test tests/unit/*.test.mjs",
    "test:migrations": "node --experimental-test-module-mocks --test tests/unit/migration-*.test.mjs tests/unit/db-migrate-cli.test.mjs",
    "test:deployability": "node --test tests/unit/deployability-contract.test.mjs",
    "test:coverage": "node tests/support/coverage.mjs --lines=93 --branches=81 --functions=98",
    "test:coverage:report": "node tests/support/coverage.mjs --report",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run check:deployability && npm run validate:catalog && npm run check:runtime-ddl && npm run check:syntax && npm run check:crdt && npm run test:coverage && npm run test:e2e",
    "start:test": "node tests/support/static-server.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.48.0",
    "acorn": "^8.15.0",
    "c8": "12.0.0",
    "esbuild": "0.25.9",
    "ms": "^2.1.3",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.6",
    "yaml": "2.9.1"
  }
}
