{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://accounts.google.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js-de.sentry-cdn.com https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://*.sentry.io https://*.ingest.sentry.io https://in.logtail.com; upgrade-insecure-requests" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/capabilities",
      "destination": "/api/auth?endpoint=capabilities"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth?endpoint=signup"
    },
    {
      "source": "/api/auth/activation/resend",
      "destination": "/api/auth?endpoint=activation-resend"
    },
    {
      "source": "/api/auth/activation/verify",
      "destination": "/api/auth?endpoint=activation-verify"
    },
    {
      "source": "/api/auth/password-reset/request",
      "destination": "/api/auth?endpoint=password-reset-request"
    },
    {
      "source": "/api/auth/password-reset/consume",
      "destination": "/api/auth?endpoint=password-reset-consume"
    },
    {
      "source": "/api/auth/recent-auth",
      "destination": "/api/auth?endpoint=recent-auth"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth?endpoint=login"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth?endpoint=me"
    },
    {
      "source": "/api/auth/logout-all",
      "destination": "/api/auth?endpoint=logout-all"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth?endpoint=logout"
    },
    {
      "source": "/api/auth/google/start",
      "destination": "/api/auth?endpoint=google-start"
    },
    {
      "source": "/api/auth/google/reauth/start",
      "destination": "/api/auth?endpoint=google-reauth-start"
    },
    {
      "source": "/api/auth/google/callback",
      "destination": "/api/auth?endpoint=google-callback"
