    {
      "source": "/api/healthz",
      "destination": "/api/data?endpoint=health&probe=live"
    },
    {
      "source": "/api/readyz",
      "destination": "/api/data?endpoint=health&probe=ready"
    },
    {
      "source": "/api/health",
      "destination": "/api/data?endpoint=health"
    },
    {
      "source": "/api/notifications/prefs",
      "destination": "/api/ops?endpoint=notifications-prefs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly",
      "schedule": "0 8 * * 0"
    }
  ]
}
