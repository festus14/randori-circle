# Randori Circle environment template. docs/ENVIRONMENT.md describes every
# variable (purpose, required, default, secret, where it is set) and has the
# feature flag table with production state. Copy what you need into Vercel or
# `.env.local`; never commit real values.

# Required. Generate at least 32 random bytes; never commit the real value.
JWT_SECRET=

# Recommended before enabling evaluations; defaults to JWT_SECRET when blank.
# To rotate it without invalidating history, keep prior values comma-separated.
RUN_ATTESTATION_SECRET=
RUN_ATTESTATION_PREVIOUS_SECRETS=

# Optional. Keys the daily address hash on app_logs rows without a user
# (ID-82); defaults to JWT_SECRET when blank, so either can rotate on its own.
# Rotating it only changes hashes written from then on.
LOG_ADDRESS_SECRET=

# Code execution for server-owned JavaScript/Python evaluations. Leave blank to
# keep "Run" explicitly unavailable (fail closed). Submitted code never runs in
# the API process.
#   vercel-sandbox: ephemeral Vercel Sandbox microVM per run with all egress
#                   denied. On Vercel it authenticates with the project's OIDC
#                   token automatically; no other secret is required.
#   piston:         a self-hosted Piston-compatible HTTPS endpoint (full
#                   /api/v2/execute URL). The retired public emkc.org API is
#                   rejected. EXECUTION_API_TOKEN is sent as a Bearer token.
EXECUTION_PROVIDER=
EXECUTION_API_URL=
EXECUTION_API_TOKEN=

# Required by the current Turso-backed implementation.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required canonical origin used for OAuth redirects and pairing publication
# links. Production and hosted deployments require an explicit root-level HTTPS
# origin; the isolated `npm run dev` runtime sets its exact loopback HTTP origin.
APP_URL=https://your-app.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required. Authenticates every /api/cron/* route (weekly pairing, outbox,
# outbox health, execution smoke). GitHub's `production` environment holds the
# same value.
CRON_SECRET=
# Optional, narrower secret for an external outbox scheduler (cron-job.org).
# Accepted only by /api/cron/outbox and /api/cron/outbox-health, never by
# /api/cron/weekly. Ignored unless >=32 chars and different from CRON_SECRET.
# See docs/OUTBOX_EXTERNAL_SCHEDULER.md.
OUTBOX_DISPATCH_SECRET=
# Weekly pairing boundaries use Sunday 08:00 in this IANA timezone.
PAIRING_TIME_ZONE=Europe/London
ADMIN_EMAILS=

# New production accounts must use verified Google sign-in and be allowlisted.
SIGNUP_ALLOWLIST=
# Dark-launch this only after migrations are current and an authenticated admin
# has run the data-only POST /api/init cutover.
# When true, active primary-circle membership replaces the signup allowlist.
CIRCLE_MEMBERSHIP_ENABLED=false
MULTI_CIRCLE_CONTROL_PLANE_ENABLED=false
# Independently enables dated availability in the session-selected active
# circle. Keep false until the control plane is enabled and rehearsed.
MULTI_CIRCLE_AVAILABILITY_ENABLED=false
SECONDARY_CIRCLE_COORDINATION_ENABLED=false
# Enables propose/remove/accept/clear for the current paired group in a
# selected secondary circle after managed migration v16. It is ineffective
# unless every membership/control/availability/coordination flag above is on.
SECONDARY_CIRCLE_SCHEDULING_ENABLED=false
# Queues compact schedule-email v2 intents for successful secondary schedule
# writes. Effective only through the complete scheduling flag chain above.
SECONDARY_CIRCLE_SCHEDULE_EMAIL_ENABLED=false
# Queues compact v2 pairing-email intents for newly published secondary-circle
# results. Effective only when every control/availability/coordination flag above
# is enabled and the shared outbox sender has passed staging rehearsal.
SECONDARY_CIRCLE_PAIRING_EMAIL_ENABLED=false
# Enables invitation-bound email/password registration. Production advertises
# this capability only when membership, APP_URL, Resend, and the encryption key
# below are all valid. Generate the key with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
EMAIL_PASSWORD_ACTIVATION_ENABLED=false
# Required in production when EMAIL_PASSWORD_ACTIVATION_ENABLED=true. This
# 32-byte base64url key encrypts the short-lived token while it is queued.
EMAIL_VERIFICATION_ENCRYPTION_KEY=
# Existing installations begin at version 1. Keep at most three older entries,
# newest first, as JSON: [{"version":1,"key":"base64url-key"}]. Readers accept
# v1 and v2; keep writes at 1 for the compatibility deployment, then set 2.
EMAIL_VERIFICATION_ENCRYPTION_KEY_VERSION=1
EMAIL_VERIFICATION_ENCRYPTION_PREVIOUS_KEYS=[]
EMAIL_VERIFICATION_ENVELOPE_WRITE_VERSION=1
# Required in production to queue owner-created invitation links for email.
# Keep false until the sender, encryption key, and outbox worker have passed a
# staging rehearsal. Local capture does not require this production gate.
INVITATION_EMAIL_DELIVERY_ENABLED=false
# Keep this separate from JWT and verification keys; rotate only with the
# version and bounded prior-key settings below.
INVITATION_EMAIL_ENCRYPTION_KEY=
INVITATION_EMAIL_ENCRYPTION_KEY_VERSION=1
INVITATION_EMAIL_ENCRYPTION_PREVIOUS_KEYS=[]
INVITATION_EMAIL_ENVELOPE_WRITE_VERSION=1
# Public "Request an invite" intake, primary-owner review API, and the
# `inviteRequests` capability. Requires CIRCLE_MEMBERSHIP_ENABLED=true and
# migration v21 (keep false on a database without v21). Owner digest
# email additionally needs APP_URL, RESEND_API_KEY, and RESEND_FROM.
# See docs/INVITE_REQUESTS.md.
INVITE_REQUESTS_ENABLED=false
# Issue #287 reminders (availability cutoff, agree-a-time nudge), queued by the
# /api/cron/outbox due-check and governed by each member's email preference.
# The one-hour session reminder additionally needs REMINDERS_SESSION_SOON_ENABLED.
# No migration. See docs/REMINDERS.md.
REMINDERS_ENABLED=false
REMINDERS_SESSION_SOON_ENABLED=false
# Issue #296 practice suggestions: "attempted" markers in the catalogue and up
# to three suggested exercises in the room's Problem panel, computed by
# GET /api/exercise-suggestions from verified runs and completed sessions.
# Read-only, no migration. See ID-77 in docs/IMPLEMENTED_DECISIONS.md.
EXERCISE_SUGGESTIONS_ENABLED=false
# Issue #310 admin Diagnostics (Circle view): read-only outbox, execution,
# readiness, migration ledger and error-category health for global admins
# (is_admin=1, not demo). Dead-letter replay reuses /api/admin/outbox/replay.
# No migration. See docs/IMPLEMENTED_DECISIONS.md (ID-73).
ADMIN_DIAGNOSTICS_ENABLED=false
# Issue #293 personal progress dashboard in History (/api/progress): completed
# sessions, weekly streak, catalogue coverage, verified-run outcomes and
# interview-role balance, computed per request from the member's own records.
# No migration. See docs/PROGRESS_DASHBOARD.md.
PROGRESS_DASHBOARD_ENABLED=false
# Issue #292 owner-only circle health: GET /api/circle/health, the circleHealth
# capability and the Circle tab card. Needs CIRCLE_MEMBERSHIP_ENABLED. Read-only,
# no migration. See docs/CIRCLE_HEALTH.md.
CIRCLE_HEALTH_ENABLED=false
# Issue #341 outbox personal-data retention. After delivery, the
# /api/cron/outbox run (at most hourly) removes recipient addresses and sealed
# sign-in links from delivered and suppressed outbox rows after 7 days and from
# dead letters after 30; admin replay of a redacted dead letter is refused.
# Destructive and off by default: the owner turns it on deliberately, and only
# once the matching Privacy Policy text is live. No migration. See
# docs/IMPLEMENTED_DECISIONS.md (ID-83).
OUTBOX_PII_RETENTION_ENABLED=false
# Issue #339 self-service account deletion in Edit profile
# (/api/auth/account/delete): recent sign-in, type DELETE, final confirm; the
# account is tombstoned and partners' history shows "Deleted member".
# Requires CIRCLE_MEMBERSHIP_ENABLED=true. No migration. See
# docs/ACCOUNT_DELETION.md.
ACCOUNT_DELETION_ENABLED=false
# Issue #365 member data export (GET /api/auth/account/export): download a
# JSON archive of the member's own data. Requires a sign-in from the last
# 10 minutes and is rate-limited to 5 exports per account per 15 minutes.
# No migration. See docs/DATA_EXPORT.md.
DATA_EXPORT_ENABLED=false
# Enables enumeration-safe password recovery for existing password accounts.
# Production additionally requires APP_URL, RESEND_API_KEY, RESEND_FROM, and
# the dedicated 32-byte base64url encryption key below.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_ENCRYPTION_KEY=
PASSWORD_RESET_ENCRYPTION_KEY_VERSION=1
PASSWORD_RESET_ENCRYPTION_PREVIOUS_KEYS=[]
PASSWORD_RESET_ENVELOPE_WRITE_VERSION=1
# Dark-launch credential linking/removal only after migration v9 is ready.
# The isolated loopback runtime enables its provider-free account view itself.
IDENTITY_MANAGEMENT_ENABLED=false
# Required before enabling identity management. Generate a dedicated key with
# `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`; do not reuse JWT,
# invitation, activation, or reset secrets. Start at 1 and increment whenever
# the key changes so existing observations are safely re-baselined. Versions
# are monotonic; a lower configured version than stored state fails closed.
IDENTITY_EMAIL_HASH_KEY=
IDENTITY_EMAIL_HASH_KEY_VERSION=1
IDENTITY_EMAIL_HASH_PREVIOUS_KEYS=[]
# Protected GitHub environment variable for the non-public v15 control workflow.
# Keep false except during one explicitly approved adoption or advance; this is
# not an application feature flag and does not authorize local/HTTP mutation.
CREDENTIAL_KEY_CONTROL_MUTATIONS_ENABLED=false
# Exact hostname from the protected production libSQL URL; the operator
# workflow rejects a URL for any other database endpoint.
TURSO_PRODUCTION_DATABASE_HOST=
# Development-only convenience. Do not use to bypass private-beta access control.
ALLOW_OPEN_SIGNUP=false
# Chat retention is a protected, disabled-by-default operation. The first
# production enable additionally requires the v11 database control, a completed
# private export followed by a provider backup, and the CHAT_RETENTION.md gates.
CHAT_RETENTION_ENABLED=false
CHAT_RETENTION_MODE=dry_run
# Protected workflow/operator values. Evidence envelopes must carry the exact
# pre-export room high-water and exported scope-binding digest. Never log them.
CHAT_RETENTION_EXPECTED_GENERATION=0
CHAT_RETENTION_SCOPE_KEY=
CHAT_RETENTION_CIRCLE_ID=
CHAT_RETENTION_WEEK_ID=
CHAT_RETENTION_PAIR_GROUP_ID=
CHAT_RETENTION_RUN_ID=
CHAT_RETENTION_REASON_CODE=
CHAT_RETENTION_EXPORT_EVIDENCE_DIGEST=
CHAT_RETENTION_EXPORT_SCOPE_BINDING_DIGEST=
CHAT_RETENTION_EXPORT_SOURCE_MAX_MESSAGE_ID=
CHAT_RETENTION_EXPORT_THROUGH_AT=
CHAT_RETENTION_EXPORT_COMPLETED_AT=
CHAT_RETENTION_BACKUP_EVIDENCE_DIGEST=
CHAT_RETENTION_BACKUP_SCOPE_BINDING_DIGEST=
CHAT_RETENTION_BACKUP_SOURCE_MAX_MESSAGE_ID=
CHAT_RETENTION_BACKUP_THROUGH_AT=
CHAT_RETENTION_BACKUP_COMPLETED_AT=

# Optional providers. AI stays off until consent/privacy controls are reviewed.
RESEND_API_KEY=
# Required with RESEND_API_KEY; use a sender verified by your Resend account.
RESEND_FROM=
# Post-commit email delivery (ID-64, issue #250). Unset = on when running on
# Vercel (VERCEL=1), off elsewhere. `false` is the operator kill switch: mail
# then waits for the scheduled /api/cron/outbox worker. `true` opts in off
# Vercel. Never active for the local identity adapter.
OUTBOX_IMMEDIATE_DELIVERY=
AI_ENABLED=false
GROQ_API_KEY=
OPENAI_API_KEY=
# Sentry reports only from production (VERCEL_ENV=production, or
# SENTRY_ENVIRONMENT=production off Vercel); local runtime, tests and CI are
# always disabled. Set SENTRY_ENABLE_PREVIEW=true only to report previews.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_ENABLE_PREVIEW=false

# Optional `.env.local` settings for `npm run dev`. The local runtime otherwise
# uses these defaults, rejects production/remote-database credentials, and
# isolates the process from any ambient provider credentials.
RANDORI_LOCAL_HOST=127.0.0.1
RANDORI_LOCAL_PORT=3000
# Must be an absolute file: URL directly inside this checkout's `.local/`.
# RANDORI_LOCAL_DATABASE_URL=file:///absolute/path/to/randori-circle/.local/randori.db

# ---------------------------------------------------------------------------
# Everything below is commented out on purpose. It is listed so that this file
# names every variable the code reads; see docs/ENVIRONMENT.md for each one.
# Do not set these in Vercel. Only the "operator scripts" group belongs in a
# local shell or `.env.local`.
# ---------------------------------------------------------------------------

# Fallback name for SENTRY_DSN, read only when SENTRY_DSN is empty.
# NEXT_PUBLIC_SENTRY_DSN=

# Operator scripts run by hand.
# VERCEL_OIDC_TOKEN=
# SMOKE_EXPECTED_CAPABILITIES=
# SMOKE_EXPECTED_REGISTRATION_MODE=verified_invite
# SMOKE_TIMEOUT_MS=15000
# UI_SCREENSHOTS_VIEWPORTS=mobile,desktop
# CHAT_RETENTION_LOCAL_ADOPTION=false

# GitHub environments `turso-migration-rehearsal` and
# `turso-production-migration` only (docs/PRODUCTION_BOOTSTRAP_GUIDE.md §7).
# TURSO_PRODUCTION_PLATFORM_TOKEN=
# MIGRATION_DIGEST_HMAC_KEY=
# TURSO_ORGANIZATION=
# TURSO_GROUP=
# TURSO_PRODUCTION_DATABASE_NAME=
# TURSO_PRODUCTION_DATABASE_ID=
# TURSO_PRODUCTION_EXPECTED_BLOCK_WRITES=false
# TURSO_RESTORE_DATABASE_PREFIX=
# REHEARSAL_MAX_SNAPSHOT_AGE_MS=1800000
# REHEARSAL_MAX_EVIDENCE_AGE_MS=1800000
# MIGRATION_REHEARSAL_MAX_AGE_MS=1800000
# REHEARSAL_RPO_TARGET_MS=1800000
# REHEARSAL_RTO_TARGET_MS=900000
# TURSO_PRODUCTION_MIGRATIONS_ENABLED=false

# Set by `npm run dev` itself.
# RANDORI_LOCAL_RUNTIME=
# RANDORI_LOCAL_IDENTITY=
# RANDORI_LOCAL_FIRST_USER_ADMIN=
# RANDORI_LOCAL_DATABASE_PATH=
# TWILIO_AUTH_TOKEN=

# Fixed in the workflow YAML (pinned by check:deployability and
# check:backup-controls).
# WATCHDOG_DELIVERY_MAX_AGE_MS=
# WATCHDOG_SCHEDULE_GRACE_MS=
# WATCHDOG_WORKER_DEADLINE_MS=
# WATCHDOG_API_TIMEOUT_MS=
# WATCHDOG_MAX_PAGES=
# WATCHDOG_PER_PAGE=
# WATCHDOG_DEFAULT_BRANCH=
# WATCHDOG_CONTROL_ACTIVATION_AT=
# WATCHDOG_MAX_RUN_AGE_MS=
# WATCHDOG_STUCK_AFTER_MS=
# WATCHDOG_SLOT_GRACE_MS=
# WATCHDOG_SLOT_DEADLINE_MS=
# REHEARSAL_WORKFLOW_PATH=
# REHEARSAL_GITHUB_ENVIRONMENT=
# RESTORE_REHEARSAL_CONFIRM=
# REHEARSAL_POLL_ATTEMPTS=
# REHEARSAL_POLL_INTERVAL_MS=
# REHEARSAL_POLL_DURATION_MS=
# REHEARSAL_CLEANUP_POLL_ATTEMPTS=
# REHEARSAL_CLEANUP_POLL_INTERVAL_MS=
# REHEARSAL_CLEANUP_POLL_DURATION_MS=
