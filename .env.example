# Required. Generate at least 32 random bytes; never commit the real value.
JWT_SECRET=

# Recommended before enabling evaluations; defaults to JWT_SECRET when blank.
# To rotate it without invalidating history, keep prior values comma-separated.
RUN_ATTESTATION_SECRET=
RUN_ATTESTATION_PREVIOUS_SECRETS=

# Required by the current Turso-backed implementation.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public origin used for OAuth redirects.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Separate secret used only by the weekly scheduler.
CRON_SECRET=
ADMIN_EMAILS=

# New production accounts must use verified Google sign-in and be allowlisted.
SIGNUP_ALLOWLIST=
# Dark-launch this only after an authenticated admin has run POST /api/init.
# When true, active primary-circle membership replaces the signup allowlist.
CIRCLE_MEMBERSHIP_ENABLED=false
# Development-only convenience. Do not use to bypass private-beta access control.
ALLOW_OPEN_SIGNUP=false
# Fresh databases only: enable after backup to create the first allowlisted Google admin,
# then disable before POST /api/init. Normal deployments must leave this false.
AUTH_SCHEMA_BOOTSTRAP_ENABLED=false

# Optional providers. AI stays off until consent/privacy controls are reviewed.
RESEND_API_KEY=
# Required with RESEND_API_KEY; use a sender verified by your Resend account.
RESEND_FROM=
AI_ENABLED=false
GROQ_API_KEY=
OPENAI_API_KEY=
SENTRY_DSN=

# Keep false unless a written agreement explicitly permits automated ingestion.
LEETCODE_INGESTION_AUTHORIZED=false

# Optional `.env.local` settings for `npm run dev`. The local runtime otherwise
# uses these defaults, rejects production/remote-database credentials, and
# isolates the process from any ambient provider credentials.
RANDORI_LOCAL_HOST=127.0.0.1
RANDORI_LOCAL_PORT=3000
# Must be an absolute file: URL directly inside this checkout's `.local/`.
# RANDORI_LOCAL_DATABASE_URL=file:///absolute/path/to/randori-circle/.local/randori.db
