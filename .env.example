# Set by the platform (Vercel, GitHub Actions or Node); never set by hand.
# NODE_ENV=
# VERCEL=
# VERCEL_ENV=
# VERCEL_URL=
# CI=
# GITHUB_ACTIONS=
# GITHUB_TOKEN=
# GITHUB_API_URL=
# GITHUB_REPOSITORY=
# GITHUB_REPOSITORY_ID=
# GITHUB_EVENT_NAME=
# GITHUB_REF=
# GITHUB_SHA=
# GITHUB_WORKFLOW_REF=
# GITHUB_WORKFLOW_SHA=
# GITHUB_RUN_ID=
# GITHUB_RUN_ATTEMPT=
# GITHUB_ENV=
# GITHUB_OUTPUT=
# RUNNER_TEMP=

# Test harness only (tests/ and playwright.config.js).
# E2E_PORT=
# COVERAGE_DEBUG=
# RANDORI_MIGRATED_TEMPLATE_CACHE=
