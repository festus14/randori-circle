# TURSO_DATABASE_TIMEOUT_MS=
# GITHUB_API_TIMEOUT_MS=
# MIGRATION_GITHUB_ENVIRONMENT=
# KEY_CONTROL_GITHUB_ENVIRONMENT=
# EXECUTION_SMOKE_TIMEOUT_MS=
# EXECUTION_SMOKE_TRIGGER=
# UI_SCREENSHOTS_PROD_URL=
# UI_SCREENSHOTS_SCOPE=
# UI_SCREENSHOTS_OUT=
# SMOKE_BASE_URL=

# Copied from workflow_dispatch inputs, computed in a step, or written to
# GITHUB_ENV by a workflow step.
# CHAT_RETENTION_ACTION=
# OPERATION=
# CONFIRMATION=
# PURPOSE=
# EXPECTED_VERSION=
# EXPECTED_GENERATION=
# EXPECTED_STATE=
# TARGET_VERSION=
# REHEARSAL_RUN_ID=
# REHEARSAL_RUN_ATTEMPT=
# DEFAULT_BRANCH=
# ALERT_CATEGORY=
# KEY_CONTROL_CONFIRM=
# KEY_CONTROL_OPERATION=
# KEY_CONTROL_PURPOSE=
# KEY_CONTROL_EXPECTED_VERSION=
# KEY_CONTROL_EXPECTED_GENERATION=
# KEY_CONTROL_REPO_COMMIT=
# PRODUCTION_MIGRATION_CONFIRM=
